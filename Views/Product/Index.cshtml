@model IEnumerable<Product>
@{
    ViewData["Title"] = "Book Catalog | BookVault";
    var searchString = ViewData["SearchString"] as string;
}

<div class="container-fluid py-4 px-4">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="page-title mb-1">
                <i class="bi bi-collection-fill me-2 text-gold"></i>Book Catalog
            </h1>
            <p class="text-muted mb-0">Manage your entire inventory from one place.</p>
        </div>
        <a asp-controller="Product" asp-action="Create" class="btn btn-gold btn-lg d-flex align-items-center gap-2 shadow">
            <i class="bi bi-plus-circle-fill"></i> Add New Book
        </a>
    </div>

    <div class="card vault-card mb-4 shadow-sm">
        <div class="card-body py-3">
            <form asp-controller="Product" asp-action="Index" method="get" class="d-flex gap-3 align-items-center">
                <div class="input-group flex-grow-1">
                    <span class="input-group-text bg-dark border-secondary text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="searchString"
                           value="@searchString"
                           class="form-control vault-search"
                           placeholder="Search by title, author, or genre..." />
                    @if (!string.IsNullOrEmpty(searchString))
                    {
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg"></i> Clear
                        </a>
                    }
                </div>
                <button type="submit" class="btn btn-gold px-4">Search</button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(searchString))
    {
        <div class="alert alert-dark border-0 mb-3 py-2">
            <i class="bi bi-filter-circle me-2 text-gold"></i>
            Showing results for: <strong>"@searchString"</strong> — @Model.Count() book(s) found.
        </div>
    }

    <div class="card vault-card shadow">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-bookshelf display-3 text-muted"></i>
                    <h4 class="mt-3 text-muted">No books found in the catalog.</h4>
                    <a asp-controller="Product" asp-action="Create" class="btn btn-gold mt-3">
                        <i class="bi bi-plus-circle-fill me-1"></i> Add Your First Book
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover vault-table mb-0">
                        <thead>
                            <tr>
                                <th><i class="bi bi-book me-1"></i> Title</th>
                                <th><i class="bi bi-person me-1"></i> Author</th>
                                <th><i class="bi bi-tag me-1"></i> Genre</th>
                                <th><i class="bi bi-currency-dollar me-1"></i> Price</th>
                                <th><i class="bi bi-box-seam me-1"></i> Stock</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td class="fw-semibold text-white">@product.Title</td>
                                    <td class="text-muted">@product.Author</td>
                                    <td>
                                        <span class="badge genre-badge">@product.Genre</span>
                                    </td>
                                    <td class="text-gold fw-semibold">$@product.Price.ToString("0.00")</td>
                                    <td>
                                        @if (product.StockQuantity > 10)
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success px-2 py-1">
                                                <i class="bi bi-check-circle me-1"></i>In Stock (@product.StockQuantity)
                                            </span>
                                        }
                                        else if (product.StockQuantity > 0)
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning px-2 py-1">
                                                <i class="bi bi-exclamation-triangle me-1"></i>Low (@product.StockQuantity)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger px-2 py-1">
                                                <i class="bi bi-x-circle me-1"></i>Out of Stock
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-fill"></i> Edit
                                            </a>
                                            <a asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash3-fill"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="d-flex gap-3 mt-3 flex-wrap">
            <div class="stat-pill">
                <i class="bi bi-book-fill me-1"></i> @Model.Count() Total Books
            </div>
            <div class="stat-pill text-warning">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.Count(p => p.StockQuantity <= 10 && p.StockQuantity > 0) Low Stock
            </div>
            <div class="stat-pill text-danger">
                <i class="bi bi-x-circle-fill me-1"></i> @Model.Count(p => p.StockQuantity == 0) Out of Stock
            </div>
        </div>
    }
</div>
