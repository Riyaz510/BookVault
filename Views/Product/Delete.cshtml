@model Product
@{
    ViewData["Title"] = "Delete Book | BookVault";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="d-flex align-items-center gap-3 mb-4">
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Back to Catalog
                </a>
                <h1 class="page-title mb-0">
                    <i class="bi bi-trash3-fill me-2 text-danger"></i>Delete Book
                </h1>
            </div>

            <div class="card vault-card border-danger shadow">
                <div class="card-header bg-danger bg-opacity-10 border-danger py-3 px-4">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                    <span class="text-danger fw-semibold">This action cannot be undone.</span>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted mb-4">Are you sure you want to remove the following book from BookVault?</p>

                    <div class="vault-detail-row">
                        <span class="vault-label">Title</span>
                        <span class="text-white fw-semibold">@Model.Title</span>
                    </div>
                    <div class="vault-detail-row">
                        <span class="vault-label">Author</span>
                        <span class="text-muted">@Model.Author</span>
                    </div>
                    <div class="vault-detail-row">
                        <span class="vault-label">Genre</span>
                        <span class="badge genre-badge">@Model.Genre</span>
                    </div>
                    <div class="vault-detail-row">
                        <span class="vault-label">Price</span>
                        <span class="text-gold fw-semibold">$@Model.Price.ToString("0.00")</span>
                    </div>
                    <div class="vault-detail-row">
                        <span class="vault-label">Stock</span>
                        <span class="text-muted">@Model.StockQuantity units</span>
                    </div>

                    <form method="post" asp-action="Delete" class="mt-4">
                        <input asp-for="Id" type="hidden" />
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-danger btn-lg flex-grow-1">
                                <i class="bi bi-trash3-fill me-1"></i> Yes, Delete This Book
                            </button>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
