@{
    ViewData["Title"] = "Home | BookVault";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container px-4">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="hero-badge">
                    <i class="bi bi-stars"></i> Digital Catalog & Inventory Hub
                </div>
                <h1 class="hero-title text-white mb-3">
                    Manage Your<br />
                    <span class="text-gold">Book Inventory</span><br />
                    with Precision.
                </h1>
                <p class="hero-subtitle mb-4">
                    BookVault gives you a powerful, clean interface to track, manage, and organize your entire book catalog — titles, authors, pricing, and stock — all in one place.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-gold btn-lg px-4">
                        <i class="bi bi-collection-fill me-2"></i> Explore Catalog
                    </a>
                    <a asp-controller="Product" asp-action="Create" class="btn btn-outline-light btn-lg px-4">
                        <i class="bi bi-plus-circle me-2"></i> Add New Book
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-flex justify-content-center align-items-center">
                <div style="font-size: 9rem; opacity: 0.12; color: #f59e0b; line-height: 1; user-select: none;">
                    <i class="bi bi-safe2-fill"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stat Cards -->
<section class="container px-4 py-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-book-fill"></i>
                </div>
                <div class="stat-number text-gold">∞</div>
                <div class="stat-label">Books Supported</div>
                <p class="text-muted small mt-2 mb-0">Add unlimited book entries to your personal vault.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-shield-check-fill"></i>
                </div>
                <div class="stat-number">CRUD</div>
                <div class="stat-label">Full Operations</div>
                <p class="text-muted small mt-2 mb-0">Create, read, update, and delete any record instantly.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-search"></i>
                </div>
                <div class="stat-number">Live</div>
                <div class="stat-label">Search & Filter</div>
                <p class="text-muted small mt-2 mb-0">Instantly search across title, author, and genre.</p>
            </div>
        </div>
    </div>

    <!-- Quick Link -->
    <div class="text-center mt-5">
        <p class="text-muted">Ready to get started?</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-gold btn-lg px-5">
            <i class="bi bi-arrow-right-circle-fill me-2"></i> Go to Book Catalog
        </a>
    </div>
</section>
